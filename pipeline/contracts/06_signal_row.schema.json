{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarmvault.ai/pipeline/contracts/06_signal_row.schema.json",
  "title": "SignalRow",
  "description": "Backtester output: a single signal at a single timestamp for a single instrument, with factor attribution. Produced by NautilusTrader (live parity) or vectorbt (sweeps). Filtered upstream by Alphalens.",
  "type": "object",
  "required": [
    "run_id",
    "strategy_id",
    "engine",
    "instrument",
    "event_ts",
    "as_of_ts",
    "signal",
    "factor_attribution",
    "conviction_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "strategy_id": {
      "type": "string",
      "description": "Stable strategy identifier across runs; pinned to a git commit + config in the run manifest."
    },
    "engine": {
      "type": "string",
      "enum": ["nautilus_trader", "vectorbt", "alphalens_research_only"]
    },
    "instrument": {
      "type": "object",
      "required": ["symbol", "asset_class"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string" },
        "exchange": { "type": "string" },
        "asset_class": { "type": "string", "enum": ["equity", "etf", "crypto", "fx", "future", "option", "bond"] }
      }
    },
    "event_ts": { "type": "string", "format": "date-time", "description": "Bar/event timestamp the signal pertains to." },
    "as_of_ts": { "type": "string", "format": "date-time", "description": "When the signal was decidable. MUST be <= event_ts to be backtest-legal." },
    "signal": {
      "type": "object",
      "required": ["direction", "strength"],
      "additionalProperties": false,
      "properties": {
        "direction": { "type": "string", "enum": ["long", "short", "flat", "exit"] },
        "strength": { "type": "number", "minimum": -1, "maximum": 1, "description": "Signed conviction post-scaling. -1 = max short, +1 = max long." },
        "horizon_bars": { "type": "integer", "minimum": 1 },
        "stop_loss": { "type": "number" },
        "take_profit": { "type": "number" }
      }
    },
    "factor_attribution": {
      "type": "object",
      "description": "Per-factor contribution to this signal. Sums to ~signal.strength. The audit trail.",
      "additionalProperties": { "type": "number" }
    },
    "factor_selection": {
      "type": "object",
      "description": "What Alphalens / Boruta selected and the IC at selection time.",
      "additionalProperties": false,
      "properties": {
        "selected_features": { "type": "array", "items": { "type": "string" } },
        "selection_ic": { "type": "number" },
        "selection_run_id": { "type": "string" }
      }
    },
    "conviction_ids": {
      "type": "array",
      "description": "ConvictionRow IDs (entity_id + as_of_ts) that contributed.",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ic": { "type": "number" },
        "ic_pvalue": { "type": "number" },
        "turnover": { "type": "number" },
        "quantile": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
